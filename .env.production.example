# Copy to .env.production on the server. Never commit the filled file.
POSTGRES_PASSWORD=replace-with-64-hex-characters
LOCAL_HTTP_PORT=8090
APP_ORIGIN=https://shmavito.ravshan.tv
TWITCH_CLIENT_ID=replace-with-client-id
TWITCH_CLIENT_SECRET=replace-with-new-production-secret
TWITCH_REDIRECT_URI=https://shmavito.ravshan.tv/api/auth/callback/twitch
# Необязательно: ключ ApiAd для импорта объявлений при блокировке IP сервера Avito.
APIAD_API_KEY=
AUTH_SECRET=replace-with-independent-64-hex-characters
CRON_SECRET=replace-with-another-independent-64-hex-characters
FOUNDER_TWITCH_LOGIN=rafchibiskus
FOUNDER_TWITCH_ID=866415576
